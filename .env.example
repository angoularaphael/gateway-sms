# PostgreSQL
DATABASE_URL=postgresql://sms:sms@localhost:5432/sms_gateway?schema=public

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# API / CORS
API_URL=http://localhost:4000
API_PORT=4000
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Admin seed (used only by prisma/seed.ts)
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=changeme
ADMIN_NAME=Administrateur

# Device heartbeat
DEVICE_OFFLINE_AFTER_SECONDS=90

# Conservative defaults — never exceed operator plan limits
DEFAULT_DAILY_LIMIT=80
DEFAULT_RATE_PER_MINUTE=4
SMS_JOB_ATTEMPTS=3
SMS_JOB_BACKOFF_MS=60000
