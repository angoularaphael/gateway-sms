# === Bot Hosting : coller dans /home/container/.env ===
# Fichier à uploader : bothosting/bootstrap.js → /home/container/index.js
# Startup panel : node index.js
# Egg Node 22, RAM 1024 Mo mini

BOT_GITHUB_REPO=https://github.com/angoularaphael/gateway-sms.git
BOT_REPO_BRANCH=main
BOT_APP_DIR=sms-gateway-app

PORT=21724
SERVER_PORT=21724
HOST=0.0.0.0

API_URL=http://prem-eu2.bot-hosting.net:21724
CORS_ORIGIN=http://prem-eu2.bot-hosting.net:21724
FRONTEND_URL=http://prem-eu2.bot-hosting.net:21724

# Projet SMS Supabase : https://vxsdfspkpyahdprgoctu.supabase.co
# Pooler IPv4 — mets le vrai mot de passe (pas dans Git)
DATABASE_URL=postgresql://postgres.vxsdfspkpyahdprgoctu:MOT_DE_PASSE@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require

# Upstash Redis — mets le token dans /home/container/.env (pas dans Git)
REDIS_URL=rediss://default:TOKEN@cheerful-jaybird-263331.upstash.io:6379

JWT_SECRET=change-moi-longue-chaine-aleatoire
JWT_EXPIRES_IN=7d

ADMIN_EMAIL=angoularaphael05@gmail.com
ADMIN_PASSWORD=change-moi-mot-de-passe
ADMIN_NAME=Administrateur

DEFAULT_DAILY_LIMIT=80
DEFAULT_RATE_PER_MINUTE=4
