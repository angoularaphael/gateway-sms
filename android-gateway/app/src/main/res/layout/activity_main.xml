<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07111C"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SMS Gateway"
            android:textColor="#3EE0B0"
            android:textSize="24sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/serverUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="URL serveur (http://prem-eu2.bot-hosting.net:21724)"
            android:inputType="textUri"
            android:textColor="#E8F1F8"
            android:textColorHint="#8AA4B8" />

        <EditText
            android:id="@+id/deviceId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Device ID (ANDROID-001)"
            android:textColor="#E8F1F8"
            android:textColorHint="#8AA4B8" />

        <EditText
            android:id="@+id/apiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Clé API"
            android:inputType="textPassword"
            android:textColor="#E8F1F8"
            android:textColorHint="#8AA4B8" />

        <Button
            android:id="@+id/connectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Connecter" />

        <Button
            android:id="@+id/defaultSmsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Definir comme appli SMS par defaut (obligatoire)" />

        <Button
            android:id="@+id/restrictedSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Parametres de l&apos;appli (reglages restreints)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Android 15 : si le choix SMS n&apos;apparait pas, ouvre les parametres de l&apos;appli, 3 points, Autoriser les reglages restreints, puis reviens."
            android:textColor="#8AA4B8"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:lineSpacingExtra="6dp"
            android:textColor="#E8F1F8"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
