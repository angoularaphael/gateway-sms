<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07111C"
    android:descendantFocusability="beforeDescendants"
    android:fillViewport="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SMS Gateway"
            android:textColor="#3EE0B0"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="URL serveur"
            android:textColor="#8AA4B8"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/serverUrl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:autofillHints=""
                android:hint="http://prem-eu2.bot-hosting.net:21724"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="text|textNoSuggestions"
                android:minHeight="48dp"
                android:textColor="#E8F1F8"
                android:textColorHint="#8AA4B8" />

            <Button
                android:id="@+id/pasteUrlButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Coller" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Device ID (ANDROID-001)"
            android:textColor="#8AA4B8"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/deviceId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:autofillHints=""
                android:hint="ANDROID-001"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="text|textCapCharacters|textNoSuggestions"
                android:minHeight="48dp"
                android:textColor="#E8F1F8"
                android:textColorHint="#8AA4B8" />

            <Button
                android:id="@+id/pasteDeviceButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Coller" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Cle API"
            android:textColor="#8AA4B8"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/apiKey"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:autofillHints=""
                android:hint="Colle la cle ici"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="text|textNoSuggestions|textVisiblePassword"
                android:minHeight="48dp"
                android:textColor="#E8F1F8"
                android:textColorHint="#8AA4B8" />

            <Button
                android:id="@+id/pasteKeyButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Coller" />
        </LinearLayout>

        <Button
            android:id="@+id/connectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Connecter" />

        <Button
            android:id="@+id/defaultSmsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Definir comme appli SMS par defaut (obligatoire)" />

        <Button
            android:id="@+id/restrictedSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Parametres de l&apos;appli (reglages restreints)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Utilise le bouton Coller a cote de chaque champ. N&apos;utilise pas le collage long-appui du clavier si ca ferme l&apos;appli."
            android:textColor="#8AA4B8"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:lineSpacingExtra="6dp"
            android:textColor="#E8F1F8"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
